{
    "name": "api",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/index.js",
        "build": "prisma generate --schema=prisma/schema.prisma && tsup src/index.js --format esm --clean --out-dir dist --minify",
        "start": "node dist/index.js",
        "lint": "eslint . --max-warnings 0",
        "check-types": "tsc --noEmit",
        "check-imports": "bun scripts/check-imports.ts",
        "openapi:generate": "bun scripts/generate-openapi.ts",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:test-connection": "bun scripts/test-db-connection.ts",
        "db:generate": "prisma generate --schema=prisma/schema.prisma",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "postinstall": "npm run build"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "prisma": {
        "seed": "bun prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.965.0",
        "@aws-sdk/s3-request-presigner": "^3.965.0",
        "@prisma/adapter-mariadb": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "@supabase/supabase-js": "^2.87.1",
        "@types/nodemailer": "^7.0.11",
        "basic-ftp": "^5.2.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "js-yaml": "^4.1.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "nodemailer": "^6.9.8",
        "puppeteer": "^21.0.0",
        "redoc-express": "^2.1.3",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.5.0",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^11.0.0",
        "@vercel/node": "^3.0.0",
        "bun-types": "latest",
        "eslint": "^9.39.1",
        "prisma": "^7.3.0",
        "swagger-jsdoc": "^6.2.8",
        "tsup": "^8.5.1",
        "typescript": "5.9.2"
    }
}